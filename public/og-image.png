<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <!-- Градиент для фона -->
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#000000;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#1e293b;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#334155;stop-opacity:1" />
    </linearGradient>
    
    <!-- Градиент для текста -->
    <linearGradient id="textGradient" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#dc2626;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ef4444;stop-opacity:1" />
    </linearGradient>
    
    <!-- Свечение для логотипа -->
    <filter id="logoGlow">
      <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    
    <!-- Свечение для текста -->
    <filter id="textGlow">
      <feGaussianBlur stdDeviation="2" result="coloredBlur"/>
      <feMerge>
        <feMergeNode in="coloredBlur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>
  
  <!-- Фон -->
  <rect width="1200" height="630" fill="url(#bgGradient)" />
  
  <!-- Декоративные элементы -->
  <circle cx="100" cy="100" r="80" fill="#dc2626" opacity="0.1" />
  <circle cx="1100" cy="530" r="100" fill="#ef4444" opacity="0.1" />
  <circle cx="1050" cy="150" r="60" fill="#dc2626" opacity="0.05" />
  <circle cx="150" cy="480" r="70" fill="#ef4444" opacity="0.05" />
  
  <!-- Логотип Selen.IT -->
  <g filter="url(#logoGlow)">
    <text x="100" y="200" font-family="Arial, sans-serif" font-size="72" font-weight="900" fill="#ffffff">
      Selen
    </text>
    <text x="340" y="200" font-family="Arial, sans-serif" font-size="72" font-weight="900" fill="url(#textGradient)">
      .IT
    </text>
  </g>
  
  <!-- Подчеркивание логотипа -->
  <rect x="100" y="220" width="340" height="4" fill="url(#textGradient)" rx="2" />
  
  <!-- Основной заголовок -->
  <text x="100" y="320" font-family="Arial, sans-serif" font-size="48" font-weight="700" fill="#ffffff" filter="url(#textGlow)">
    Digital Agency
  </text>
  
  <!-- Подзаголовок -->
  <text x="100" y="380" font-family="Arial, sans-serif" font-size="24" font-weight="400" fill="#94a3b8">
    Web Development • UI/UX Design • Branding
  </text>
  
  <!-- Описание -->
  <text x="100" y="420" font-family="Arial, sans-serif" font-size="20" font-weight="300" fill="#64748b">
    We build digital experiences that drive results
  </text>
  
  <!-- Призыв к действию -->
  <rect x="100" y="480" width="200" height="50" fill="url(#textGradient)" rx="25" />
  <text x="200" y="510" font-family="Arial, sans-serif" font-size="18" font-weight="600" fill="#ffffff" text-anchor="middle">
    Get Started
  </text>
  
  <!-- Декоративные линии -->
  <line x1="100" y1="560" x2="300" y2="560" stroke="url(#textGradient)" stroke-width="2" opacity="0.5" />
  <line x1="320" y1="560" x2="520" y2="560" stroke="url(#textGradient)" stroke-width="2" opacity="0.3" />
  
  <!-- Веб-сайт URL -->
  <text x="100" y="600" font-family="Arial, sans-serif" font-size="16" font-weight="400" fill="#64748b">
    selenit-digital-agency.vercel.app
  </text>
</svg>
